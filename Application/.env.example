# Public OAuth client ids for Continue with Google / Apple on auth forms.
# Redirect URI defaults to {origin}/api/auth/callback/{provider}
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_APPLE_OAUTH_CLIENT_ID=
# Optional override. Use {provider} as a placeholder.
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/{provider}

# Playground ChatGPT uses each visitor's own OpenAI API key from the browser.
# Do not set OPENAI_API_KEY here — cloned and deployed sites must not share a project key.
# Optional model override for playground chat requests:
# OPENAI_PLAYGROUND_MODEL=gpt-5-mini
