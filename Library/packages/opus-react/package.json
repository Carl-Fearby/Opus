{
  "name": "opus-react",
  "version": "0.6.4",
  "description": "A production-ready React design system for modern business applications, dashboards and data-rich workflows.",
  "homepage": "https://project-opus.netlify.app/documentation/components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carl-Fearby/Opus.git",
    "directory": "Library/packages/opus-react"
  },
  "bugs": {
    "url": "https://github.com/Carl-Fearby/Opus/issues"
  },
  "author": {
    "name": "Carl Fearby",
    "email": "carlfearby@me.com"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "typescript",
    "ui",
    "dashboard",
    "forms",
    "data-visualization",
    "accessibility",
    "dark-mode",
    "themeable"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./index.css": "./dist/index.css",
    "./flags.css": "./dist/flags.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets/npm",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/patch-css-exports.mjs && node scripts/copy-flag-icons.mjs",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "three": "^0.185.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "esbuild-css-modules-plugin": "^3.1.5",
    "flag-icons": "^7.5.0",
    "lightningcss": "^1.32.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
